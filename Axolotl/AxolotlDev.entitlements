<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.axolotl.browser.dev</string>
		<!-- Read-only use: LegacyLunaMigration copies Luna's Keychain items from here. -->
		<string>$(AppIdentifierPrefix)com.luna.browser.dev</string>
	</array>
</dict>
</plist>
